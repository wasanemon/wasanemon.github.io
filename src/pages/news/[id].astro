---
/** NEWS 詳細 — Markdown 本文を表示 */
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Window from '../../components/Window.astro';
import { getDictionary, defaultLocale, localizePath } from '../../i18n';
import { formatDate } from '../../utils/format';

export async function getStaticPaths() {
  const entries = await getCollection('news');
  return entries.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const locale = Astro.currentLocale ?? defaultLocale;
const t = getDictionary(locale);
---

<Base title={entry.data.title} active="news">
  <article class="prose-jp mx-auto">
    <p class="flex items-center gap-3">
      <time
        datetime={entry.data.date.toISOString().slice(0, 10)}
        class="display-type text-sm text-ink-soft">{formatDate(entry.data.date)}</time
      >
      <span class="display-type rounded-chip border border-ink bg-sky px-2 py-0.5 text-xs"
        >{t.news.categories[entry.data.category] ?? entry.data.category}</span
      >
    </p>
    <h1 class="mt-3 text-2xl leading-snug font-bold">{entry.data.title}</h1>

    <Window title={t.news.window} class="news-body mt-6" bodyClass="px-5 py-6 sm:px-8">
      <Content />
    </Window>

    <p class="mt-8">
      <a
        href={localizePath('/news/', locale)}
        class="display-type text-sm text-navy underline underline-offset-4 hover:text-ink"
        >← {t.news.backToList}</a
      >
    </p>
  </article>
</Base>

<style>
  /* Markdown 本文のスタイル（情報レイヤー: 可読性優先） */
  .news-body :global(p + p) {
    margin-top: 1em;
  }
  .news-body :global(a) {
    color: var(--color-navy);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .news-body :global(ul) {
    list-style: disc;
    padding-left: 1.4em;
    margin: 1em 0;
  }
  .news-body :global(ol) {
    list-style: decimal;
    padding-left: 1.4em;
    margin: 1em 0;
  }
  .news-body :global(h2),
  .news-body :global(h3) {
    font-weight: 700;
    margin: 1.5em 0 0.5em;
  }
</style>
