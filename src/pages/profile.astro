---
/** PROFILE — プロフィール */
import Base from '../layouts/Base.astro';
import SectionTitle from '../components/SectionTitle.astro';
import ImageSlot from '../components/ImageSlot.astro';
import Floppy from '../components/deco/Floppy.astro';
import Folder from '../components/deco/Folder.astro';
import { getDictionary, defaultLocale } from '../i18n';
import { assetUrl } from '../data/assets';
import SqlConsole from '../components/SqlConsole.astro';

const t = getDictionary(Astro.currentLocale ?? defaultLocale);
const hasPortrait = assetUrl('portrait') !== null;
---

<Base title={t.profile.title} active="profile">
  <SectionTitle title={t.profile.title} />

  <div class:list={['grid gap-8 md:gap-10', hasPortrait && 'md:grid-cols-[280px_1fr]']}>
    {
      hasPortrait && (
        <ImageSlot
          asset="portrait"
          class="w-full max-w-70 rounded-sticker border-2 border-ink shadow-sticker-lg"
        />
      )
    }

    <div>
      <h2 class="display-type text-5xl">{t.profile.name}</h2>
      <p class="display-type mt-1 text-ink-soft">{t.profile.reading}</p>
      <p
        class="display-type mt-3 inline-block rounded-chip border-2 border-ink bg-sky px-4 py-1 text-sm"
      >
        {t.profile.roles}
      </p>

      <dl class="mt-6 grid grid-cols-[auto_1fr] gap-x-6 gap-y-2 text-sm">
        {
          t.profile.facts.map((fact) => (
            <>
              <dt class="display-type text-ink-soft">{fact.label}</dt>
              <dd>{fact.value}</dd>
            </>
          ))
        }
      </dl>

      <div class="prose-jp mt-6">
        {t.profile.bio.map((paragraph) => <p class="text-sm leading-loose">{paragraph}</p>)}
        {t.profile.en && <p lang="en" class="text-sm leading-relaxed text-ink-soft">{t.profile.en}</p>}
      </div>

      <h3 class="display-type mt-8 flex items-center gap-2 text-xl">
        <Floppy class="h-5 w-5" />
        {t.profile.highlightsHeading}
      </h3>
      <ul class="mt-3 flex flex-col gap-2">
        {
          t.profile.highlights.map((item) => (
            <li class="sticker-card px-4 py-2 text-sm">{item}</li>
          ))
        }
      </ul>

      <h3 class="display-type mt-8 flex items-center gap-2 text-xl">
        <Folder class="h-5 w-5" />
        {t.profile.historyHeading}
      </h3>
      <dl class="mt-3 grid grid-cols-[auto_1fr] gap-x-6 gap-y-2 text-sm">
        {
          t.profile.history.map((item) => (
            <>
              <dt class="display-type text-ink-soft">{item.year}</dt>
              <dd>{item.text}</dd>
            </>
          ))
        }
      </dl>

      <h3 class="display-type mt-8 flex items-center gap-2 text-xl">
        <Floppy class="h-5 w-5" />
        {t.profile.modelHeading}
      </h3>
      <p class="mt-3 text-sm leading-loose">{t.profile.model}</p>
      <ul class="mt-3 flex flex-wrap gap-3">
        {
          t.profile.modelLinks.map((link) => (
            <li>
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="display-type inline-block rounded-chip border-2 border-ink bg-paper px-4 py-1.5 text-sm shadow-sticker transition-transform motion-safe:hover:-translate-y-0.5 hover:bg-aqua"
              >
                {link.label}
                <span class="sr-only">({t.a11y.externalLink})</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <section class="mt-12 scroll-mt-28" aria-labelledby="sql-heading">
    <h2 id="sql-heading" class="display-type mb-4 scroll-mt-28 flex items-center gap-2 text-xl">
      <Folder class="h-5 w-5" />
      {t.sql.heading}
    </h2>
    <SqlConsole />
  </section>
</Base>
