---
/** TOP — HERO + 受賞・プロジェクト導線 + NEWSプレビュー */
import Base from '../layouts/Base.astro';
import BootOpening from '../components/BootOpening.astro';
import ImageSlot from '../components/ImageSlot.astro';
import NewsRow from '../components/NewsRow.astro';
import Window from '../components/Window.astro';
import HobbyIcon from '../components/deco/HobbyIcon.astro';
import Avatar from '../components/deco/Avatar.astro';
import Floppy from '../components/deco/Floppy.astro';
import Folder from '../components/deco/Folder.astro';
import Cursor from '../components/deco/Cursor.astro';
import { getDictionary, defaultLocale, localizePath } from '../i18n';
import { getNews } from '../utils/news';
import { assetUrl } from '../data/assets';

const locale = Astro.currentLocale ?? defaultLocale;
const isEn = locale === 'en';
const t = getDictionary(locale);
const news = (await getNews(locale)).slice(0, 3);
const hasKeyVisual = assetUrl('keyVisual') !== null;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  dateModified: '2026-10-07',
  inLanguage: locale,
  mainEntity: {
    '@type': 'Person',
    '@id': 'https://wasanemon.github.io/#person',
    name: isEn ? 'Yusuke Miyazaki' : '宮﨑祐介',
    alternateName: isEn ? ['宮﨑祐介', '宮崎祐介'] : ['宮崎祐介', 'Yusuke Miyazaki', 'みやざき ゆうすけ'],
    url: 'https://wasanemon.github.io/',
    birthPlace: { '@type': 'Place', name: isEn ? 'Gunma, Japan' : '群馬県' },
    alumniOf: [
      {
        '@type': 'EducationalOrganization',
        name: isEn ? 'Gunma Prefectural Takasaki High School' : '群馬県立高崎高等学校',
      },
      {
        '@type': 'CollegeOrUniversity',
        name: isEn ? 'Faculty of Policy Management, Keio University' : '慶應義塾大学 総合政策学部',
      },
    ],
    affiliation: [
      {
        '@type': 'CollegeOrUniversity',
        name: isEn
          ? 'Graduate School of Media and Governance, Keio University'
          : '慶應義塾大学大学院 政策・メディア研究科',
      },
      { '@type': 'Organization', name: 'model agency friday', url: 'https://fridayfarm.net/' },
    ],
    award: isEn
      ? ['MITOU Super Creator, MITOU IT Program FY2025 (METI / IPA)', 'Selected for the MITOU IT Program FY2025 (IPA)']
      : [
          '2025年度 未踏IT人材発掘・育成事業 スーパークリエータ認定(経済産業省・IPA)',
          '2025年度 未踏IT人材発掘・育成事業 採択(IPA)',
        ],
    knowsAbout: isEn
      ? ['Database systems', 'Transaction processing', 'Concurrency control', 'MySQL']
      : ['データベースシステム', 'トランザクション処理', '並行性制御', 'MySQL'],
    jobTitle: 'Researcher',
    sameAs: [
      'https://www.ipa.go.jp/jinzai/mitou/koubo/career/2025/2025-supercreator-22.html',
      'https://github.com/wasanemon',
      'https://fridayfarm.net/yusuke-miyazaki/',
      'https://www.instagram.com/wasanemon/',
    ],
  },
};
---

<Base active="top">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <BootOpening slot="overlay" />

  <!-- HERO -->
  <section class="relative grid items-center gap-8 md:grid-cols-[1.3fr_1fr]">
    <!-- 装飾レイヤー（情報を持たない） -->
    <Floppy class="absolute -top-2 right-[-1.5rem] hidden h-10 w-10 rotate-12 md:block" />
    <Folder
      class="absolute bottom-[-1.75rem] left-[-0.5rem] hidden h-10 w-10 -rotate-6 md:block"
    />

    <div
      class="grid grid-cols-[minmax(0,1fr)_auto] items-end gap-x-4 [grid-template-areas:'head_avatar''body_body'] md:[grid-template-areas:'head_avatar''body_avatar']"
    >
      <div class="min-w-0 self-start [grid-area:head]">
        <p class="display-type text-sm text-navy">{t.home.heroRoles}</p>
        <h1
          class="display-type mt-2 text-6xl leading-none text-paper sm:text-7xl [-webkit-text-stroke:2.5px_var(--color-ink)] [text-shadow:5px_5px_0_var(--color-amber)]"
        >
          {t.home.heroLogo}
        </h1>
        <p class="display-type mt-2 text-xl">
          {t.home.heroName} <span class="inline-block text-sm whitespace-nowrap text-ink-soft">{t.home.heroReading}</span>
        </p>

      </div>
      <div class="min-w-0 [grid-area:body]">
        <p class="sticker-card mt-6 inline-block rounded-bubble px-5 py-2 text-lg font-bold whitespace-nowrap">
          {t.home.catchCopy}
        </p>
        <p class="mt-3 text-sm leading-relaxed text-ink-soft">
          <span class="block">{t.home.affiliations.join(' ・ ')}</span>
          {t.home.subCopy.map((item) => <span class="block">{item}</span>)}
        </p>

        <a
          href={localizePath('/kamo/', locale)}
          class="group mt-6 inline-flex items-center gap-3 rounded-bubble border-2 border-ink bg-call-green px-6 py-3 font-bold shadow-sticker transition-transform motion-safe:hover:-translate-y-0.5 hover:bg-lemon"
        >
          <Cursor
            class="h-6 w-6 text-call-green-deep motion-safe:group-hover:animate-[icon-wiggle_0.8s_ease-in-out_infinite]"
          />
          {t.home.cta}
        </a>
      </div>
      <Avatar
        label={t.home.avatarLabel}
        class="[grid-area:avatar] [&_.avatar-svg]:h-44 sm:[&_.avatar-svg]:h-52 md:[&_.avatar-svg]:h-64"
      />
    </div>

    {
      hasKeyVisual ? (
        <ImageSlot
          asset="keyVisual"
          loading="eager"
          class="w-full rounded-sticker border-2 border-ink shadow-sticker-lg"
        />
      ) : (
        /* キービジュアル未投入のあいだは、ウィンドウ風の数値カードを出す */
        <Window title={t.home.card.windowTitle} class="shadow-sticker-lg" bodyClass="px-6 pt-5 pb-7">
          <p class="display-type text-sm text-navy">{t.home.card.heading}</p>
          <dl class="mt-3 flex flex-col gap-4">
            {t.home.card.stats.map((stat, i) => (
              <div
                class:list={[
                  'rounded-sticker border-2 border-ink px-4 py-3',
                  i % 2 === 0 ? 'bg-sky' : 'bg-aqua',
                ]}
              >
                <dt class="sr-only">{stat.label}</dt>
                <dd class="display-type text-5xl leading-none sm:text-6xl">{stat.value}</dd>
                <dd class="mt-2 text-sm" aria-hidden="true">{stat.label}</dd>
              </div>
            ))}
          </dl>
          <p class="mt-4 text-sm text-ink-soft">{t.home.card.foot}</p>
        </Window>
      )
    }
  </section>

  <!-- ティッカー（一時停止ボタン付き = WCAG 2.2.2。reduced-motion / 停止時は折り返して全文表示） -->
  <div class="mt-12 flex items-start gap-2" role="group" aria-label={t.home.tickerLabel}>
    <button
      type="button"
      id="ticker-toggle"
      aria-pressed="false"
      data-label-pause={t.home.tickerPause}
      data-label-play={t.home.tickerPlay}
      class="display-type shrink-0 rounded-chip border-2 border-ink bg-paper px-3 py-2 text-xs shadow-sticker hover:bg-lemon"
      >{t.home.tickerPause}</button
    >
    <div id="ticker" class="ticker min-w-0 flex-1 overflow-hidden rounded-chip border-2 border-ink bg-lemon py-2">
      <div class="ticker-track flex w-max">
        {
          [false, true].map((clone) => (
            <div class:list={[clone && 'ticker-clone']} aria-hidden={clone ? 'true' : undefined}>
              {t.home.ticker.map((item) => (
                <span class="display-type mx-5 flex items-center gap-2 text-sm">
                  <Floppy class="h-4 w-4 shrink-0" />
                  {item}
                </span>
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </div>
  <script is:inline type="module">
    // ティッカーの一時停止/再開（停止中は折り返し表示で全項目が読める）
    const toggle = document.getElementById('ticker-toggle');
    const ticker = document.getElementById('ticker');
    if (toggle && ticker) {
      toggle.addEventListener('click', () => {
        const paused = ticker.classList.toggle('is-paused');
        toggle.setAttribute('aria-pressed', String(paused));
        toggle.textContent = paused ? toggle.dataset.labelPlay : toggle.dataset.labelPause;
      });
    }
  </script>

  <!-- AWARD + LATEST PROJECT -->
  <div class="mt-14 grid gap-8 md:grid-cols-2">
    <section aria-labelledby="award-heading">
      <h2 id="award-heading" class="display-type text-2xl">{t.home.awardLabel}</h2>
      <Window
        title={t.home.awardWindow}
        href={localizePath(t.home.award.href, locale)}
        class="mt-4 h-[calc(100%-3rem)] hover:bg-lemon"
        bodyClass="flex items-center gap-5 p-4"
      >
        <Floppy class="h-14 w-14 shrink-0" />
        <span>
          <span class="display-type block text-2xl leading-snug">{t.home.award.title}</span>
          <span class="mt-1 block text-sm text-ink-soft">{t.home.award.meta}</span>
          <span
            class="display-type mt-3 inline-block rounded-chip border-2 border-ink bg-amber px-4 py-1 text-sm"
            >▶ {t.home.award.more}</span
          >
        </span>
      </Window>
    </section>

    <section aria-labelledby="latest-heading">
      <h2 id="latest-heading" class="display-type text-2xl">{t.home.projectLabel}</h2>
      <Window
        title={t.home.projectWindow}
        href={localizePath('/kamo/', locale)}
        class="mt-4 h-[calc(100%-3rem)] hover:bg-sky"
        bodyClass="flex items-center gap-5 p-4"
      >
        <Folder class="h-14 w-14 shrink-0" />
        <span>
          <span class="display-type block text-3xl">{t.home.project.title}</span>
          <span class="mt-1 block text-sm text-ink-soft">{t.home.project.meta}</span>
          <span
            class="display-type mt-3 inline-block rounded-chip border-2 border-ink bg-cyan px-4 py-1 text-sm"
            >▶ {t.home.cta}</span
          >
        </span>
      </Window>
    </section>
  </div>

  <!-- NEWS プレビュー -->
  <section class="mt-14" aria-labelledby="news-heading">
    <h2 id="news-heading" class="display-type flex items-center gap-2 text-2xl">
      <Folder class="h-6 w-6" />
      {t.home.newsHeading}
    </h2>
    <div class="mt-4 flex flex-col gap-3">
      {
        news.map((entry) => (
          <NewsRow
            id={entry.id}
            title={entry.data.title}
            date={entry.data.date}
            category={entry.data.category}
          />
        ))
      }
    </div>
    <p class="mt-5 text-right">
      <a
        href={localizePath('/news/', locale)}
        class="display-type text-sm text-navy underline underline-offset-4 hover:text-ink"
        >{t.home.newsMore} →</a
      >
    </p>
  </section>

  <!-- FAVORITES: デスクトップに並ぶアイコン -->
  <section class="mt-14" aria-labelledby="favorites-heading">
    <h2 id="favorites-heading" class="display-type flex items-baseline gap-3 text-2xl">
      {t.home.favoritesHeading}
      <span class="text-sm text-ink-soft">{t.home.favoritesLead}</span>
    </h2>
    <ul class="mt-5 grid grid-cols-4 gap-x-1 gap-y-6 sm:grid-cols-5 md:grid-cols-10">
      {
        t.home.favorites.map((item) => (
          <li class="group flex flex-col items-center gap-2 text-center">
            <HobbyIcon
              name={item.icon}
              class="h-12 w-12 motion-safe:group-hover:animate-[icon-bounce_0.6s_ease-in-out]"
            />
            <span class="display-type px-1 text-xs leading-snug group-hover:bg-navy group-hover:text-paper">
              {item.label}
            </span>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
