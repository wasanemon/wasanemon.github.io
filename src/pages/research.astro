---
/** RESEARCH — 論文と発表(データ: src/data/research.ts) */
import Base from '../layouts/Base.astro';
import SectionTitle from '../components/SectionTitle.astro';
import Window from '../components/Window.astro';
import { getDictionary, defaultLocale, pick } from '../i18n';
import { publications } from '../data/research';

const locale = Astro.currentLocale ?? defaultLocale;
const isEn = locale === 'en';
const t = getDictionary(locale);
/* 英語版では英語表記に差し替える。題名を訳した業績には、その旨の注記を足す */
const pubs = publications.map((pub) => ({
  ...pub,
  title: pick(locale, pub.title, pub.titleEn),
  venue: pick(locale, pub.venue, pub.venueEn),
  notes: isEn
    ? [...(pub.notesEn ?? []), ...(pub.titleEn && t.research.translatedNote ? [t.research.translatedNote] : [])]
    : pub.notes,
}));

/* 種別チップの塗り(すべてトークン色) */
const kindBg: Record<string, string> = {
  POSTER: 'bg-aqua',
  JOURNAL: 'bg-sky',
  WORKSHOP: 'bg-lemon',
};
---

<Base title={t.research.title} active="research">
  <SectionTitle title={t.research.title} lead={t.research.lead} />

  <div class="flex flex-col gap-5">
    {
      pubs.map((pub) => (
        <article>
        <Window title={`${pub.id}${t.research.fileExt}`} bodyClass="px-5 py-5 sm:px-7">
          <p class="flex flex-wrap items-center gap-x-3 gap-y-1">
            <span class="display-type text-sm text-ink-soft">{pub.year}</span>
            <span
              class:list={[
                'display-type rounded-chip border border-ink px-2 py-0.5 text-xs',
                kindBg[pub.kind] ?? 'bg-aqua',
              ]}
            >
              {pub.kind}
            </span>
            <span class="text-sm text-ink-soft">{pub.venue}</span>
          </p>
          <h2 class="mt-2 text-xl leading-snug font-bold">{pub.title}</h2>

          {pub.notes.length > 0 && (
            <ul class="mt-3 flex flex-wrap gap-2">
              {pub.notes.map((note) => (
                <li class="rounded-chip bg-desk px-3 py-0.5 text-sm">{note}</li>
              ))}
            </ul>
          )}

          {pub.links.length > 0 && (
            <ul class="mt-4 flex flex-wrap gap-3" aria-label={t.research.linksHeading}>
              {pub.links.map((link) => (
                <li>
                  <a
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="display-type inline-block rounded-chip border-2 border-ink bg-paper px-4 py-1.5 text-sm shadow-sticker transition-transform motion-safe:hover:-translate-y-0.5 hover:bg-aqua"
                  >
                    {link.label}
                    <span class="sr-only">({t.a11y.externalLink})</span>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </Window>
        </article>
      ))
    }
  </div>
</Base>
