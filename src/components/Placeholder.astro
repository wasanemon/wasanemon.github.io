---
/**
 * 公式素材が未投入の画像スロットに表示する Y2K トーンの自前プレースホルダ。
 * すべて SVG + トークン参照で描画（外部画像は使わない）。
 *
 * variant:
 *  - hero:     キービジュアル枠（4:5・着信画面風）
 *  - jacket:   ジャケット枠（1:1・CD風）
 *  - portrait: アー写枠（3:4・プリクラ風）
 *  - video:    動画枠（16:9・ブラウン管風）
 */
import type { PlaceholderVariant } from '../data/assets';
import { getDictionary, defaultLocale } from '../i18n';

interface Props {
  variant: PlaceholderVariant;
  label: string;
  class?: string;
}
const { variant, label, class: className } = Astro.props;
const t = getDictionary(Astro.currentLocale ?? defaultLocale);

const box: Record<PlaceholderVariant, string> = {
  hero: '0 0 400 500',
  jacket: '0 0 400 400',
  portrait: '0 0 300 400',
  video: '0 0 480 270',
};
---

<svg
  class={className}
  viewBox={box[variant]}
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${label}${t.placeholder.preparingSuffix}`}
>
  {
    variant === 'hero' && (
      <>
        {/* 着信画面風: 淡ピンク地 + 電波表示 + 受話器バッジ */}
        <rect width="400" height="500" fill="var(--color-ichigo-milk)" />
        <g opacity="0.35" font-size="26">
          <text x="30" y="90">🍓</text>
          <text x="330" y="150">🦋</text>
          <text x="60" y="420">🦋</text>
          <text x="320" y="450">🍓</text>
          <text x="200" y="60">🍓</text>
        </g>
        <rect x="16" y="16" width="368" height="468" rx="24" fill="none" stroke="var(--color-ichigo)" stroke-width="3" stroke-dasharray="10 8" />
        <text x="36" y="52" font-family="var(--font-display)" font-size="17" fill="var(--color-ichigo-deep)">
          {t.placeholder.statusBar}
        </text>
        <circle cx="200" cy="235" r="64" fill="var(--color-milk)" stroke="var(--color-ink)" stroke-width="3" />
        <path
          d="M182 214l-6.6 1.8c-3.4 1-6 4-6 7.6 0 28.2 24.2 52.4 52.4 52.4 3.6 0 6.6-2.6 7.6-6l1.8-6.6c.8-3.2-.8-6.6-3.8-8l-10.4-4.6c-2.4-1-5.2-.6-7 1.4l-3.8 4c-8.4-4.6-14.4-10.6-19-19l4-3.8c2-1.8 2.4-4.6 1.4-7l-4.6-10.4c-1.4-3-4.8-4.6-8-3.8Z"
          fill="var(--color-call-green)"
          stroke="var(--color-ink)"
          stroke-width="2.4"
        />
        <text x="200" y="345" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--color-ink)">
          {t.placeholder.keyVisual}
        </text>
        <text x="200" y="378" text-anchor="middle" font-family="var(--font-display)" font-size="18" fill="var(--color-ichigo-deep)">
          {t.placeholder.comingSoon}
        </text>
      </>
    )
  }
  {
    variant === 'jacket' && (
      <>
        {/* CD風: ソーダ地 + ディスク + センターホール */}
        <rect width="400" height="400" fill="var(--color-soda-milk)" />
        <circle cx="200" cy="200" r="140" fill="var(--color-milk)" stroke="var(--color-ink)" stroke-width="3" />
        <circle cx="200" cy="200" r="104" fill="none" stroke="var(--color-ichigo)" stroke-width="2" stroke-dasharray="4 6" />
        <circle cx="200" cy="200" r="72" fill="none" stroke="var(--color-soda)" stroke-width="2" stroke-dasharray="4 6" />
        <circle cx="200" cy="200" r="30" fill="var(--color-soda-milk)" stroke="var(--color-ink)" stroke-width="3" />
        <circle cx="200" cy="200" r="10" fill="var(--color-milk)" stroke="var(--color-ink)" stroke-width="2" />
        <g font-size="24" opacity="0.5">
          <text x="40" y="60">🍓</text>
          <text x="330" y="350">🦋</text>
        </g>
        <text x="200" y="330" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--color-ink)">
          {t.placeholder.jacket}
        </text>
        <rect x="10" y="10" width="380" height="380" rx="16" fill="none" stroke="var(--color-ink)" stroke-width="3" />
      </>
    )
  }
  {
    variant === 'portrait' && (
      <>
        {/* プリクラ風: 二重フレーム + シルエット */}
        <rect width="300" height="400" fill="var(--color-lemon)" />
        <rect x="14" y="14" width="272" height="372" rx="18" fill="var(--color-milk)" stroke="var(--color-ichigo)" stroke-width="3" />
        <ellipse cx="150" cy="170" rx="52" ry="58" fill="var(--color-ichigo-milk)" stroke="var(--color-ink)" stroke-width="2.4" />
        <path
          d="M62 386c6-70 44-104 88-104s82 34 88 104"
          fill="var(--color-ichigo-milk)"
          stroke="var(--color-ink)"
          stroke-width="2.4"
        />
        <g font-size="22">
          <text x="28" y="52">🍓</text>
          <text x="248" y="52">🦋</text>
          <text x="28" y="372">🦋</text>
          <text x="248" y="372">🍓</text>
        </g>
        {/* ネームタグ風の下地（シルエットと文字の重なりを防ぐ） */}
        <rect x="40" y="330" width="220" height="34" rx="10" fill="var(--color-milk)" stroke="var(--color-ichigo)" stroke-width="2" />
        <text x="150" y="353" text-anchor="middle" font-family="var(--font-display)" font-size="18" fill="var(--color-ichigo-deep)">
          {t.placeholder.photo}
        </text>
      </>
    )
  }
  {
    variant === 'video' && (
      <>
        {/* ブラウン管風: 暗い画面 + 走査線 + 再生ボタン */}
        <rect width="480" height="270" rx="14" fill="var(--color-ink)" />
        <g stroke="var(--color-milk)" stroke-width="1" opacity="0.12">
          {Array.from({ length: 13 }, (_, i) => (
            <line x1="0" y1={20 + i * 20} x2="480" y2={20 + i * 20} />
          ))}
        </g>
        <circle cx="240" cy="118" r="44" fill="var(--color-ichigo)" stroke="var(--color-milk)" stroke-width="3" />
        <path d="M228 98v40l34-20Z" fill="var(--color-milk)" />
        <text x="240" y="210" text-anchor="middle" font-family="var(--font-display)" font-size="20" fill="var(--color-milk)">
          {t.placeholder.comingSoon}
        </text>
        <text x="24" y="40" font-family="var(--font-display)" font-size="16" fill="var(--color-soda)">
          {t.placeholder.rec}
        </text>
      </>
    )
  }
</svg>
