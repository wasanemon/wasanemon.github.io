---
/**
 * ☎ 受話器の自作SVG装飾。装飾専用（aria-hidden）。
 * fill は currentColor（親要素の text-* トークンで色を決める）
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 40 40"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <path
    d="M11.3 4.1 8 5c-1.7.5-3 2-3 3.8C5 22.9 17.1 35 31.2 35c1.8 0 3.3-1.3 3.8-3l.9-3.3c.4-1.6-.4-3.3-1.9-4l-5.2-2.3c-1.2-.5-2.6-.3-3.5.7l-1.9 2c-4.2-2.3-7.2-5.3-9.5-9.5l2-1.9c1-.9 1.2-2.3.7-3.5L14.3 5c-.6-1.5-2.4-2.3-4-1.9Z"
    fill="currentColor"
    stroke="var(--color-ink)"
    stroke-width="2"
    stroke-linejoin="round"></path>
</svg>
