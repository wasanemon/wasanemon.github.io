---
/** 🦋 自作SVG装飾。装飾専用（aria-hidden） */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 44 40"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <path
    d="M20 20C14 11 6 7 4 9c-2.2 2.2-.2 10 7.5 14.5C6 24.5 3.6 28.6 5 30.6 6.8 33.2 15 30.5 20 24.5Z"
    fill="var(--color-soda)"
    stroke="var(--color-ink)"
    stroke-width="2"
    stroke-linejoin="round"></path>
  <path
    d="M24 20c6-9 14-13 16-11 2.2 2.2.2 10-7.5 14.5 5.5 1 7.9 5.1 6.5 7.1C37.2 33.2 29 30.5 24 24.5Z"
    fill="var(--color-soda)"
    stroke="var(--color-ink)"
    stroke-width="2"
    stroke-linejoin="round"></path>
  <rect x="20" y="13" width="4" height="17" rx="2" fill="var(--color-ink)"></rect>
  <path
    d="M21 13c-1.5-3-4-5-6-5.5M23 13c1.5-3 4-5 6-5.5"
    stroke="var(--color-ink)"
    stroke-width="1.8"
    stroke-linecap="round"></path>
  <circle cx="11" cy="15" r="2.2" fill="var(--color-ichigo-milk)"></circle>
  <circle cx="33" cy="15" r="2.2" fill="var(--color-ichigo-milk)"></circle>
</svg>
