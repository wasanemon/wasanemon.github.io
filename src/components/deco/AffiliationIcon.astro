---
/**
 * TOPの所属ラベル用のドット絵アイコン。商標ロゴは使わず、汎用のモチーフで描く
 * (school = 校舎 / camera = カメラ)。色はすべてトークン。
 */
interface Props {
  name: 'school' | 'camera';
  class?: string;
}
const { name, class: className } = Astro.props;
const ink = 'var(--color-ink)';
---

<svg
  class={className}
  viewBox="0 0 16 16"
  shape-rendering="crispEdges"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  {
    name === 'school' && (
      <>
        <rect x="7" y="1" width="2" height="1" fill={ink} />
        <rect x="5" y="2" width="6" height="1" fill={ink} />
        <rect x="3" y="3" width="10" height="1" fill={ink} />
        <rect x="1" y="4" width="14" height="2" fill={ink} />
        <rect x="2" y="6" width="12" height="8" fill="var(--color-paper)" />
        <rect x="2" y="6" width="1" height="8" fill={ink} />
        <rect x="13" y="6" width="1" height="8" fill={ink} />
        <rect x="4" y="7" width="2" height="7" fill="var(--color-navy)" />
        <rect x="7" y="7" width="2" height="7" fill="var(--color-navy)" />
        <rect x="10" y="7" width="2" height="7" fill="var(--color-navy)" />
        <rect x="1" y="14" width="14" height="1" fill={ink} />
      </>
    )
  }
  {
    name === 'camera' && (
      <>
        <rect x="5" y="2" width="5" height="2" fill={ink} />
        <rect x="1" y="4" width="14" height="10" fill={ink} />
        <rect x="2" y="5" width="12" height="8" fill="var(--color-chrome)" />
        <rect x="5" y="6" width="6" height="6" fill={ink} />
        <rect x="6" y="7" width="4" height="4" fill="var(--color-cyan)" />
        <rect x="6" y="7" width="1" height="1" fill="var(--color-paper)" />
        <rect x="12" y="6" width="1" height="1" fill="var(--color-amber)" />
      </>
    )
  }
</svg>
