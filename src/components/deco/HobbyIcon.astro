---
/**
 * 「すきなもの」のデスクトップアイコン。自作SVG、色はすべてトークン。
 * 装飾専用(aria-hidden)。ラベルは呼び出し側で付ける。
 */
export type HobbyIconName =
  | 'insect'
  | 'outdoor'
  | 'sports'
  | 'kebab'
  | 'naan'
  | 'sake'
  | 'dj'
  | 'music'
  | 'club'
  | 'cafe'
  | 'taco'
  | 'eating'
  | 'fashion'
  | 'walk'
  | 'drive'
  | 'rain'
  | 'grass'
  | 'shochu'
  | 'cat'
  | 'drawing';

interface Props {
  name: HobbyIconName;
  class?: string;
}
const { name, class: className } = Astro.props;
const ink = 'var(--color-ink)';
---

<svg
  class={className}
  viewBox="0 0 40 40"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  stroke-linecap="square"
  stroke-linejoin="miter"
>
  {
    name === 'insect' && (
      <>
        {/* カブトムシ */}
        <path d="M11 20H5M11 26H4M12 32H6M29 20h6M29 26h7M28 32h6" stroke={ink} stroke-width="2" />
        <path d="M20 13V5M20 5l-4-2M20 5l4-2" stroke={ink} stroke-width="2.4" />
        <rect x="15" y="10" width="10" height="7" fill="var(--color-ink-soft)" stroke={ink} stroke-width="2" />
        <path d="M11 17h18v13l-4 6H15l-4-6Z" fill="var(--color-navy)" stroke={ink} stroke-width="2" />
        <path d="M20 17v19" stroke={ink} stroke-width="2" />
        <rect x="14" y="21" width="3" height="3" fill="var(--color-cyan)" />
      </>
    )
  }
  {
    name === 'outdoor' && (
      <>
        {/* テント */}
        <rect x="29" y="5" width="6" height="6" fill="var(--color-amber)" stroke={ink} stroke-width="2" />
        <path d="M20 8 4 33h32Z" fill="var(--color-call-green)" stroke={ink} stroke-width="2" />
        <path d="M20 17l-6 16h12Z" fill="var(--color-ink)" />
        <path d="M2 33h36" stroke={ink} stroke-width="2" />
      </>
    )
  }
  {
    name === 'sports' && (
      <>
        {/* ボール */}
        <circle cx="20" cy="20" r="14" fill="var(--color-amber)" stroke={ink} stroke-width="2" />
        <path d="M20 6v28M6 20h28" stroke={ink} stroke-width="2" />
        <path d="M10 10c5 5 5 15 0 20M30 10c-5 5-5 15 0 20" stroke={ink} stroke-width="2" />
      </>
    )
  }
  {
    name === 'kebab' && (
      <>
        {/* 串のケバブ */}
        <path d="M5 35 35 5" stroke={ink} stroke-width="2.4" />
        <rect x="9" y="22" width="9" height="9" transform="rotate(-45 13.5 26.5)" fill="var(--color-amber)" stroke={ink} stroke-width="2" />
        <rect x="15.5" y="15.5" width="9" height="9" transform="rotate(-45 20 20)" fill="var(--color-call-red)" stroke={ink} stroke-width="2" />
        <rect x="22" y="9" width="9" height="9" transform="rotate(-45 26.5 13.5)" fill="var(--color-call-green)" stroke={ink} stroke-width="2" />
      </>
    )
  }
  {
    name === 'naan' && (
      <>
        {/* チーズナン */}
        <path d="M20 4c9 4 15 13 15 21 0 7-6 11-15 11S5 32 5 25C5 17 11 8 20 4Z" fill="var(--color-lemon)" stroke={ink} stroke-width="2" />
        <path d="M20 9v24M9 24h22" stroke={ink} stroke-width="1.6" stroke-dasharray="3 3" />
        <rect x="13" y="16" width="4" height="4" fill="var(--color-amber)" />
        <rect x="23" y="18" width="4" height="4" fill="var(--color-amber)" />
        <rect x="15" y="27" width="4" height="4" fill="var(--color-amber)" />
        <rect x="24" y="27" width="3" height="3" fill="var(--color-amber)" />
      </>
    )
  }
  {
    name === 'sake' && (
      <>
        {/* 徳利とおちょこ */}
        <path d="M11 5h8v7l5 7v16H6V19l5-7Z" fill="var(--color-paper)" stroke={ink} stroke-width="2" />
        <rect x="6" y="22" width="18" height="6" fill="var(--color-navy)" stroke={ink} stroke-width="2" />
        <path d="M27 25h9l-2 10h-5Z" fill="var(--color-cyan)" stroke={ink} stroke-width="2" />
      </>
    )
  }
  {
    name === 'dj' && (
      <>
        {/* ターンテーブル */}
        <rect x="4" y="8" width="32" height="26" fill="var(--color-chrome)" stroke={ink} stroke-width="2" />
        <circle cx="17" cy="21" r="10" fill="var(--color-ink)" />
        <circle cx="17" cy="21" r="3.5" fill="var(--color-amber)" />
        <path d="M31 12v10l-7 6" stroke={ink} stroke-width="2.4" />
        <rect x="29" y="27" width="4" height="4" fill="var(--color-call-red)" stroke={ink} stroke-width="1.5" />
      </>
    )
  }
  {
    name === 'music' && (
      <>
        {/* 音符 */}
        <path d="M14 29V8l18-4v21" stroke={ink} stroke-width="2.6" />
        <path d="M14 8l18-4v6l-18 4Z" fill="var(--color-ink)" />
        <rect x="6" y="25" width="9" height="8" fill="var(--color-cyan)" stroke={ink} stroke-width="2" />
        <rect x="24" y="21" width="9" height="8" fill="var(--color-amber)" stroke={ink} stroke-width="2" />
      </>
    )
  }
  {
    name === 'club' && (
      <>
        {/* ミラーボール */}
        <path d="M20 2v7" stroke={ink} stroke-width="2" />
        <circle cx="20" cy="22" r="13" fill="var(--color-chrome)" stroke={ink} stroke-width="2" />
        <path d="M7 22h26M9 15h22M9 29h22M20 9v26M13 11v22M27 11v22" stroke={ink} stroke-width="1.4" />
        <rect x="14" y="16" width="5" height="5" fill="var(--color-cyan)" />
        <rect x="21" y="23" width="5" height="5" fill="var(--color-amber)" />
        <path d="M34 6v6M31 9h6M4 31v6M1 34h6" stroke={ink} stroke-width="2" />
      </>
    )
  }
  {
    name === 'cafe' && (
      <>
        {/* コーヒーカップ */}
        <path d="M14 4v6M20 2v8M26 4v6" stroke={ink} stroke-width="2" />
        <path d="M28 18h6v9h-6" stroke={ink} stroke-width="2.4" />
        <path d="M8 14h20v13l-3 5H11l-3-5Z" fill="var(--color-paper)" stroke={ink} stroke-width="2" />
        <rect x="10" y="16" width="16" height="5" fill="var(--color-ink-soft)" />
        <path d="M4 36h28" stroke={ink} stroke-width="2.4" />
      </>
    )
  }
  {
    name === 'shochu' && (
      <>
        {/* 焼酎: 一升瓶とロックグラス */}
        <path d="M9 3h6v8l4 5v20H5V16l4-5Z" fill="var(--color-teal)" stroke={ink} stroke-width="2" />
        <rect x="8" y="20" width="8" height="10" fill="var(--color-paper)" stroke={ink} stroke-width="1.6" />
        <rect x="10" y="23" width="4" height="4" fill="var(--color-call-red)" />
        <path d="M23 22h13l-1 14H24Z" fill="var(--color-aqua)" stroke={ink} stroke-width="2" />
        <rect x="26" y="27" width="5" height="5" fill="var(--color-paper)" stroke={ink} stroke-width="1.4" />
      </>
    )
  }
  {
    name === 'cat' && (
      <>
        {/* 猫(白地に茶のぶち) */}
        <path d="M7 6l7 7h12l7-7v19l-5 9H12l-5-9Z" fill="var(--color-paper)" />
        <path d="M7 6l7 7h5v5H7Z" fill="var(--color-ginger)" />
        <path d="M33 6l-7 7h-3v4h10Z" fill="var(--color-ginger)" />
        <path d="M7 6l7 7h12l7-7v19l-5 9H12l-5-9Z" stroke={ink} stroke-width="2" />
        <rect x="13" y="18" width="4" height="4" fill={ink} />
        <rect x="23" y="18" width="4" height="4" fill={ink} />
        <path d="M18 26h4l-2 2Z" fill="var(--color-call-red)" stroke={ink} stroke-width="1.2" />
        <path d="M2 23h8M2 28h8M30 23h8M30 28h8" stroke={ink} stroke-width="1.5" />
        <path d="M9 9l3 3M31 9l-3 3" stroke={ink} stroke-width="1.5" />
      </>
    )
  }
  {
    name === 'drawing' && (
      <>
        {/* 絵を描く: スケッチブックと鉛筆 */}
        <rect x="4" y="8" width="24" height="28" fill="var(--color-paper)" stroke={ink} stroke-width="2" />
        <path d="M8 5v6M13 5v6M18 5v6M23 5v6" stroke={ink} stroke-width="2" />
        <path d="M8 30l5-8 4 5 3-4 4 7Z" fill="var(--color-cyan)" stroke={ink} stroke-width="1.5" />
        <rect x="20" y="15" width="4" height="4" fill="var(--color-amber)" />
        <path d="M27 31l3-9 6 2-3 9-5 3Z" fill="var(--color-lemon)" stroke={ink} stroke-width="1.6" transform="rotate(20 31 28)" />
        <path d="M30 22l2-6 6 2-2 6Z" fill="var(--color-call-red)" stroke={ink} stroke-width="1.6" transform="rotate(20 31 28)" />
      </>
    )
  }
  {
    name === 'taco' && (
      <>
        {/* タコス */}
        <path d="M6 18h6l2-4 3 4h4l3-5 2 5h8v6H6Z" fill="var(--color-call-green)" stroke={ink} stroke-width="2" />
        <rect x="11" y="19" width="4" height="4" fill="var(--color-call-red)" />
        <rect x="24" y="19" width="4" height="4" fill="var(--color-call-red)" />
        <path d="M3 22h34c0 8-7 13-17 13S3 30 3 22Z" fill="var(--color-amber)" stroke={ink} stroke-width="2" />
        <rect x="11" y="27" width="2" height="2" fill={ink} />
        <rect x="19" y="29" width="2" height="2" fill={ink} />
        <rect x="27" y="26" width="2" height="2" fill={ink} />
      </>
    )
  }
  {
    name === 'eating' && (
      <>
        {/* 大食い: 山盛りのどんぶりと重ねた器 */}
        <path d="M9 21c0-9 5-16 11-16s11 7 11 16Z" fill="var(--color-paper)" stroke={ink} stroke-width="2" />
        <rect x="18" y="9" width="4" height="4" fill="var(--color-call-red)" />
        <path d="M4 21h32l-4 9H8Z" fill="var(--color-navy)" stroke={ink} stroke-width="2" />
        <path d="M8 30h24v3H8ZM10 33h20v3H10Z" fill="var(--color-cyan)" stroke={ink} stroke-width="2" />
      </>
    )
  }
  {
    name === 'fashion' && (
      <>
        {/* ファッション: Tシャツ */}
        <path d="M14 5 3 11l4 8 5-2v18h16V17l5 2 4-8-11-6c-1 3-3 4-6 4s-5-1-6-4Z" fill="var(--color-amber)" stroke={ink} stroke-width="2" />
        <rect x="16" y="20" width="8" height="6" fill="var(--color-navy)" />
      </>
    )
  }
  {
    name === 'walk' && (
      <>
        {/* 散歩: スニーカー */}
        <path d="M4 13h10l5 9 14 3c2 0 3 2 3 4v2H4Z" fill="var(--color-paper)" stroke={ink} stroke-width="2" />
        <path d="M4 31h32v3H4Z" fill="var(--color-ink)" />
        <path d="M17 19l-3 2M20 22l-3 2" stroke={ink} stroke-width="2" />
        <rect x="6" y="22" width="6" height="4" fill="var(--color-cyan)" />
        <path d="M2 8h4M9 5h4" stroke={ink} stroke-width="2" />
      </>
    )
  }
  {
    name === 'drive' && (
      <>
        {/* ドライブ: 車 */}
        <path d="M10 10h18l5 9h4v10H3V19h3Z" fill="var(--color-call-red)" stroke={ink} stroke-width="2" />
        <path d="M12 13h7v6h-9ZM22 13h5l3 6h-8Z" fill="var(--color-aqua)" stroke={ink} stroke-width="1.6" />
        <rect x="7" y="26" width="8" height="8" fill="var(--color-ink)" />
        <rect x="25" y="26" width="8" height="8" fill="var(--color-ink)" />
        <rect x="10" y="29" width="2" height="2" fill="var(--color-chrome)" />
        <rect x="28" y="29" width="2" height="2" fill="var(--color-chrome)" />
      </>
    )
  }
  {
    name === 'rain' && (
      <>
        {/* 雨: 雲と雨粒 */}
        <path d="M9 22H6v-8h5V9h7V6h10v5h6v11Z" fill="var(--color-chrome)" stroke={ink} stroke-width="2" />
        <path d="M11 26l-2 5M19 26l-2 5M27 26l-2 5M15 31l-2 5M23 31l-2 5M31 31l-2 5" stroke="var(--color-navy)" stroke-width="2.6" />
      </>
    )
  }
  {
    name === 'grass' && (
      <>
        {/* 草原: 丘と草 */}
        <rect x="27" y="5" width="7" height="7" fill="var(--color-amber)" stroke={ink} stroke-width="2" />
        <path d="M2 34c6-12 14-16 22-14 6 1 10 6 14 14Z" fill="var(--color-call-green)" stroke={ink} stroke-width="2" />
        <path d="M9 24l-2-7M12 23l1-8M15 23l3-6M24 28l-2-6M27 28l1-7M30 29l3-5" stroke={ink} stroke-width="2" />
      </>
    )
  }
</svg>
