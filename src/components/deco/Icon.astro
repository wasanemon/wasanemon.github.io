---
/**
 * LINKSページ用の自作アイコン。
 * 商標ロゴの複製は避け、プラットフォームを連想させる汎用モチーフで描く
 * （tiktok=音符 / instagram=カメラ / youtube=再生 / streaming=ヘッドホン / code=コード / page=書類 / person=名刺）。
 * 公式のブランド素材を使う場合は public/assets/official/ 投入後に差し替える。
 */
import type { IconName } from '../../data/links';

interface Props {
  name: IconName;
  class?: string;
}
const { name, class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 40 40"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  {
    name === 'tiktok' && (
      <>
        <path
          d="M17 8v17.5a5.5 5.5 0 1 1-5.5-5.5"
          stroke="var(--color-ink)"
          stroke-width="3"
          stroke-linecap="round"
        />
        <path
          d="M17 8c.6 4.4 3.6 7.6 8 8"
          stroke="var(--color-amber)"
          stroke-width="3"
          stroke-linecap="round"
        />
        <circle cx="28" cy="28" r="3" fill="var(--color-cyan)" stroke="var(--color-ink)" stroke-width="2" />
      </>
    )
  }
  {
    name === 'instagram' && (
      <>
        <rect
          x="7"
          y="7"
          width="26"
          height="26"
          rx="8"
          fill="var(--color-sky)"
          stroke="var(--color-ink)"
          stroke-width="2.4"
        />
        <circle cx="20" cy="20" r="6.5" stroke="var(--color-ink)" stroke-width="2.4" />
        <circle cx="28" cy="12" r="2" fill="var(--color-amber)" />
      </>
    )
  }
  {
    name === 'youtube' && (
      <>
        <rect
          x="5"
          y="10"
          width="30"
          height="21"
          rx="6"
          fill="var(--color-call-red)"
          stroke="var(--color-ink)"
          stroke-width="2.4"
        />
        <path d="M17 15.5v10l8.5-5Z" fill="var(--color-paper)" stroke="var(--color-ink)" stroke-width="1.6" stroke-linejoin="round" />
      </>
    )
  }
  {
    name === 'streaming' && (
      <>
        <path
          d="M8 26v-4a12 12 0 0 1 24 0v4"
          stroke="var(--color-ink)"
          stroke-width="2.6"
          stroke-linecap="round"
        />
        <rect x="5" y="23" width="8" height="11" rx="3.5" fill="var(--color-cyan)" stroke="var(--color-ink)" stroke-width="2.2" />
        <rect x="27" y="23" width="8" height="11" rx="3.5" fill="var(--color-amber)" stroke="var(--color-ink)" stroke-width="2.2" />
      </>
    )
  }
  {
    name === 'code' && (
      <>
        <rect x="5" y="8" width="30" height="24" rx="6" fill="var(--color-aqua)" stroke="var(--color-ink)" stroke-width="2.4" />
        <path d="M16 15l-5 5 5 5M24 15l5 5-5 5" stroke="var(--color-ink)" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M21.5 14l-3 12" stroke="var(--color-amber)" stroke-width="2.6" stroke-linecap="round" />
      </>
    )
  }
  {
    name === 'person' && (
      <>
        <rect x="5" y="8" width="30" height="24" rx="6" fill="var(--color-sky)" stroke="var(--color-ink)" stroke-width="2.4" />
        <circle cx="15" cy="17" r="3.5" fill="var(--color-paper)" stroke="var(--color-ink)" stroke-width="2.2" />
        <path d="M9.5 27c.8-3.4 2.8-5 5.5-5s4.700 1.600 5.500 5" stroke="var(--color-ink)" stroke-width="2.2" stroke-linecap="round" />
        <path d="M24 16h6M24 21h6" stroke="var(--color-ink)" stroke-width="2.2" stroke-linecap="round" />
        <path d="M24 26h4" stroke="var(--color-amber)" stroke-width="2.2" stroke-linecap="round" />
      </>
    )
  }
  {
    name === 'page' && (
      <>
        <path d="M10 6h14l7 7v21H10Z" fill="var(--color-lemon)" stroke="var(--color-ink)" stroke-width="2.4" stroke-linejoin="round" />
        <path d="M24 6v7h7" stroke="var(--color-ink)" stroke-width="2.4" stroke-linejoin="round" />
        <path d="M15 20h11M15 25h11" stroke="var(--color-ink)" stroke-width="2.2" stroke-linecap="round" />
        <path d="M15 29h6" stroke="var(--color-amber)" stroke-width="2.2" stroke-linecap="round" />
      </>
    )
  }
</svg>
