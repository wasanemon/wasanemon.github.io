---
/** マウスカーソル(矢印)のドット絵風アイコン。色は currentColor を縁に使う */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 40 40"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <path
    d="M9 4v28l7-6.5 5 11 5-2.3-5-10.7H31Z"
    fill="var(--color-paper)"
    stroke="var(--color-ink)"
    stroke-width="2.4"
    stroke-linejoin="miter"
  />
</svg>
