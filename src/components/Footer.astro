---
/** 共通フッター */
import { getDictionary, defaultLocale } from '../i18n';
import Floppy from './deco/Floppy.astro';
import Folder from './deco/Folder.astro';
import Cursor from './deco/Cursor.astro';

const t = getDictionary(Astro.currentLocale ?? defaultLocale);
---

<footer class="mt-section border-t-2 border-ink bg-chrome">
  <div class="mx-auto max-w-5xl px-gutter py-10 text-center">
    <div class="group flex items-center justify-center gap-4" aria-hidden="true">
      <Floppy class="h-6 w-6 motion-safe:group-hover:animate-[icon-bounce_0.6s_ease-in-out]" />
      <Cursor
        class="h-6 w-6 text-amber motion-safe:group-hover:animate-[icon-wiggle_0.8s_ease-in-out]"
      />
      <Folder
        class="h-6 w-6 motion-safe:group-hover:animate-[icon-float_1.2s_ease-in-out]"
      />
    </div>
    <p class="display-type mt-4 text-sm">{t.footer.copyright}</p>
    {t.footer.staging && <p class="mt-1 text-xs text-ink-soft">{t.footer.staging}</p>}
  </div>
</footer>
