---
/** ページ見出し(ドット文字 + アイコン) */
import Floppy from './deco/Floppy.astro';

interface Props {
  title: string;
  lead?: string;
}
const { title, lead } = Astro.props;
---

<header class="mb-8">
  <h1 class="group display-type flex items-center gap-3 text-3xl sm:text-4xl">
    <Floppy
      class="h-7 w-7 shrink-0 motion-safe:group-hover:animate-[icon-bounce_0.6s_ease-in-out]"
    />
    <span>{title}</span>
  </h1>
  {lead && <p class="mt-2 text-sm text-ink-soft">{lead}</p>}
  <div class="mt-3 h-0 w-24 border-t-4 border-dotted border-amber" aria-hidden="true"></div>
</header>
