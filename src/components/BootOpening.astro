---
/**
 * 起動オープニング — ターミナル風ウィンドウにコマンドがタイピングされる演出。
 *
 * 挙動:
 *  - 初回訪問: 全画面オーバーレイ表示(背面は inert + スクロール固定)
 *  - タイピング完了後に自動で閉じる。Enter / ボタン / スキップ / Esc でいつでも閉じられる
 *  - 閉じたら localStorage に記録し、再訪問時は描画前スクリプトが表示せずスキップ
 *  - JS無効時: noscript でオーバーレイ自体を非表示(サイト閲覧を妨げない)
 *  - prefers-reduced-motion: タイピングせず全文を即表示し、自動では閉じない
 */
import { getDictionary, defaultLocale } from '../i18n';

const t = getDictionary(Astro.currentLocale ?? defaultLocale);
---

<!-- 再訪問判定(描画前に実行し、ちらつきを防ぐ) -->
<script is:inline>
  (function () {
    var done = false;
    try {
      done = localStorage.getItem('miyazaki:boot-done') === '1';
    } catch (e) {
      /* プライベートモード等では毎回オープニングを出す */
    }
    document.documentElement.classList.add(done ? 'call-done' : 'call-open');
  })();
</script>

<noscript>
  <style>
    #boot-opening {
      display: none;
    }
  </style>
</noscript>

<div
  id="boot-opening"
  class="fixed inset-0 z-50 flex flex-col items-center justify-center px-gutter"
  role="dialog"
  aria-modal="true"
  aria-label={t.boot.label}
>
  <button
    type="button"
    id="boot-skip"
    class="display-type absolute top-4 right-4 rounded-chip border-2 border-ink bg-milk px-4 py-1.5 text-sm shadow-sticker transition-transform motion-safe:hover:-translate-y-0.5 hover:bg-lemon"
  >
    {t.boot.skip} ▸▸
  </button>

  <!-- レトロPCのウィンドウ -->
  <div class="sticker-card w-full max-w-xl overflow-hidden shadow-sticker-lg">
    <!-- タイトルバー -->
    <p
      class="display-type flex items-center gap-2 border-b-2 border-ink bg-ichigo-milk px-3 py-2 text-xs"
      aria-hidden="true"
    >
      <span class="h-3 w-3 rounded-full border-2 border-ink bg-ichigo"></span>
      <span class="h-3 w-3 rounded-full border-2 border-ink bg-lemon"></span>
      <span class="h-3 w-3 rounded-full border-2 border-ink bg-call-green"></span>
      <span class="ml-2">{t.boot.windowTitle}</span>
    </p>

    <!-- 画面 -->
    <div class="boot-screen display-type bg-ink px-5 py-5 text-sm leading-relaxed text-milk sm:text-base">
      {
        t.boot.lines.map((line) => (
          <div class="boot-line" data-cmd={line.cmd} data-out={line.out}>
            <p>
              <span class="text-call-green">$</span> <span class="boot-cmd">{line.cmd}</span>
            </p>
            {line.out && <p class="boot-out text-soda">{line.out}</p>}
          </div>
        ))
      }
      <span class="boot-cursor" aria-hidden="true">█</span>
    </div>
  </div>

  <button
    type="button"
    id="boot-enter"
    class="display-type mt-8 rounded-bubble border-2 border-ink bg-call-green px-6 py-3 shadow-sticker transition-transform motion-safe:hover:-translate-y-0.5 hover:bg-lemon"
  >
    {t.boot.enter}
  </button>
  <p class="mt-2 text-xs text-ink-soft">{t.boot.hint}</p>
</div>

<style is:global>
  /* オーバーレイ背景(背面ページを完全に隠す。トークン色のみ使用) */
  #boot-opening {
    background-color: var(--color-cream);
    background-image: radial-gradient(
      color-mix(in srgb, var(--color-soda) 22%, transparent) 2px,
      transparent 2.5px
    );
    background-size: 22px 22px;
  }

  /* 再訪問時は描画自体を止める */
  html.call-done #boot-opening {
    display: none;
  }

  #boot-opening .boot-screen {
    min-height: 15rem;
  }
  #boot-opening .boot-line + .boot-line {
    margin-top: 0.35rem;
  }
  /* タイピング中: まだ出していない行を隠す(JSが .is-typing を付けたときだけ効く) */
  #boot-opening.is-typing .boot-line:not(.is-shown),
  #boot-opening.is-typing .boot-line:not(.is-done) .boot-out {
    display: none;
  }
  #boot-opening .boot-cursor {
    display: inline-block;
    color: var(--color-ichigo);
  }
  @media (prefers-reduced-motion: no-preference) {
    #boot-opening .boot-cursor {
      animation: blink-soft 1s step-end infinite;
    }
  }

  /* 退場アニメーション(global.css の call-slide-out を使用) */
  #boot-opening.is-leaving {
    animation: call-slide-out 0.45s ease-in forwards;
  }
</style>

<!-- 開閉とタイピングの制御(type="module" でDOM構築完了後に実行する) -->
<script is:inline type="module">
  (function () {
    var overlay = document.getElementById('boot-opening');
    if (!overlay) return;
    var root = document.documentElement;

    // 再訪問なら DOM からも取り除いて終了
    if (root.classList.contains('call-done')) {
      overlay.remove();
      return;
    }

    // 表示中は背面をフォーカス・操作不能にする
    var siblings = Array.prototype.filter.call(document.body.children, function (el) {
      return el !== overlay && el.tagName !== 'SCRIPT';
    });
    siblings.forEach(function (el) {
      el.setAttribute('inert', '');
    });

    var closed = false;
    var timers = [];
    function later(fn, ms) {
      timers.push(setTimeout(fn, ms));
    }

    function dismiss() {
      if (closed) return;
      closed = true;
      timers.forEach(clearTimeout);
      try {
        localStorage.setItem('miyazaki:boot-done', '1');
      } catch (e) {
        /* 保存できない環境では次回もオープニングが出るだけ */
      }
      siblings.forEach(function (el) {
        el.removeAttribute('inert');
      });
      root.classList.remove('call-open');

      var removed = false;
      function finish() {
        if (removed) return;
        removed = true;
        // call-done はここで付ける(先に付けると退場アニメーションが再生されない)
        root.classList.add('call-done');
        overlay.remove();
        var main = document.getElementById('main');
        if (main) {
          main.setAttribute('tabindex', '-1');
          main.focus({ preventScroll: true });
        }
      }
      overlay.classList.add('is-leaving');
      overlay.addEventListener('animationend', finish, { once: true });
      setTimeout(finish, 700);
    }

    document.getElementById('boot-enter').addEventListener('click', dismiss);
    document.getElementById('boot-skip').addEventListener('click', dismiss);
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' || e.key === 'Enter') {
        e.preventDefault();
        dismiss();
      }
    });
    document.getElementById('boot-enter').focus();

    // 動きを減らす設定では、全文を出したまま操作を待つ
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    // タイピング: コマンドを1文字ずつ出し、打ち終えたら出力行を出す
    var lines = Array.prototype.slice.call(overlay.querySelectorAll('.boot-line'));
    var cursor = overlay.querySelector('.boot-cursor');
    overlay.classList.add('is-typing');
    lines.forEach(function (line) {
      line.querySelector('.boot-cmd').textContent = '';
    });

    function typeLine(i) {
      if (closed) return;
      if (i >= lines.length) {
        later(dismiss, 900);
        return;
      }
      var line = lines[i];
      var cmdEl = line.querySelector('.boot-cmd');
      var cmd = line.dataset.cmd || '';
      line.classList.add('is-shown');
      cmdEl.after(cursor);
      var n = 0;
      (function tick() {
        if (closed) return;
        if (n < cmd.length) {
          n += 1;
          cmdEl.textContent = cmd.slice(0, n);
          later(tick, 45 + Math.random() * 45);
        } else {
          later(function () {
            line.classList.add('is-done');
            later(function () {
              typeLine(i + 1);
            }, line.dataset.out ? 380 : 200);
          }, 220);
        }
      })();
    }
    later(function () {
      typeLine(0);
    }, 400);
  })();
</script>
